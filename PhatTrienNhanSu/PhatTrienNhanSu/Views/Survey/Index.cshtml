@using PhatTrienNhanSu.Service.Executes.SurveyService.Models
@model SurveyFormViewModel

@{
    ViewData["Title"] = "Khảo sát Nhu cầu Học tập";
}

@if (Model != null)
{
    <div class="text-center mb-4">
        <h1 class="display-6">@Model.SurveyPeriodName</h1>
        <p class="lead">Anh/Chị vui lòng đánh dấu vào chương trình học mình mong muốn được tổ chức.</p>
    </div>

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="SurveyPeriodId" />

        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead class="table-light text-center" style="font-size: 0.9rem;">
                    <tr class="align-middle">
                        <th style="width: 5%;">Mã CT</th>
                        <th style="width: 45%;" class="text-start">Tên chương trình</th>
                        <th>1<br />Cập nhật<br />kiến thức</th>
                        <th>2<br />Nâng cao<br />kiến thức</th>
                        <th>3<br />Cần thiết</th>
                        <th>4<br />Rất cần<br />thiết</th>
                        <th>5<br />Ưu tiên</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int areaCounter = 1;
                    }
                    @foreach (var areaGroup in Model.AreaGroups)
                    {
                        <tr class="table-group-divider">
                            <td colspan="7" class="table-light">
                                <strong style="font-size: 1.1rem;">
                                    @areaCounter. @areaGroup.AreaName
                                </strong>
                            </td>
                        </tr>

                        areaCounter++;

                        @foreach (var item in areaGroup.CatalogItems)
                        {
                            var selectionIndex = Model.Selections.FindIndex(s => s.CatalogID == item.CatalogID);
                            if (selectionIndex >= 0)
                            {
                                <input type="hidden" asp-for="Selections[selectionIndex].CatalogID" />
                                <tr>
                                    <td>@item.CourseCode</td>
                                    <td class="text-start">@item.CourseName</td>
                                    <td class="text-center"><input class="form-check-input" type="checkbox" asp-for="Selections[selectionIndex].LevelUpdateKnowledge"></td>
                                    <td class="text-center"><input class="form-check-input" type="checkbox" asp-for="Selections[selectionIndex].LevelEnhanceKnowledge"></td>
                                    <td class="text-center"><input class="form-check-input" type="checkbox" asp-for="Selections[selectionIndex].LevelNecessary"></td>
                                    <td class="text-center"><input class="form-check-input" type="checkbox" asp-for="Selections[selectionIndex].LevelVeryNecessary"></td>
                                    <td class="text-center"><input class="form-check-input" type="checkbox" asp-for="Selections[selectionIndex].IsPriority"></td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 text-center">
            <button type="submit" class="btn btn-primary btn-lg">Gửi Phiếu Khảo Sát</button>
        </div>
    </form>
}
else
{
    <div class="alert alert-info text-center" role="alert">
        <h4 class="alert-heading">Thông báo</h4>
        <p>@ViewBag.Message</p>
    </div>
}