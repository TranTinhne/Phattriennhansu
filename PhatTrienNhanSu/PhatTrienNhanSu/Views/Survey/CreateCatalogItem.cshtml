@using PhatTrienNhanSu.DbContexts.Entities
@model CourseCatalog

@{
    ViewData["Title"] = "Thêm mới Khóa học vào Danh mục";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="CreateCatalogItem">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CourseCode" class="form-label">Mã chương trình (Mã CT)</label>
                    <input asp-for="CourseCode" class="form-control" />
                    <span asp-validation-for="CourseCode" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Area" class="form-label">Lĩnh vực</label>
                    <input asp-for="Area" class="form-control" />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="CourseName" class="form-label">Tên chương trình</label>
                <input asp-for="CourseName" class="form-control" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DurationHours" class="form-label">Thời lượng (giờ)</label>
                    <input asp-for="DurationHours" type="number" step="0.5" class="form-control" />
                    <span asp-validation-for="DurationHours" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ProviderID" class="form-label">Đơn vị đào tạo / NCC</label>
                    <select asp-for="ProviderID" class="form-select" asp-items="@ViewBag.ProviderList">
                        <option value="">-- Chọn một nhà cung cấp --</option>
                    </select>
                    <span asp-validation-for="ProviderID" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Thêm mới" class="btn btn-primary" />
                <a asp-action="Catalog" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}