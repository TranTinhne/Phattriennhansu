@using PhatTrienNhanSu.Service.Executes.SurveyService.Models
@model List<SurveyAreaGroup>

@{
    ViewData["Title"] = "Quản lý Danh mục Khóa học";
    int stt = 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="CreateCatalogItem" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill"></i> Thêm mới Khóa học
    </a>
</div>

<p class="text-muted">Danh sách tất cả các khóa học có thể được sử dụng trong các kỳ khảo sát.</p>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th style="width: 5%;">STT</th>
                <th style="width: 10%;">Mã CT</th>
                <th style="width: 35%;">Tên chương trình</th>
                <th style="width: 10%;">Thời lượng (h)</th>
                <th style="width: 20%;">Đơn vị đào tạo / NCC</th>
                <th style="width: 15%;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var areaGroup in Model)
                {
                    <tr class="table-secondary table-group-divider">
                        <td colspan="6"><strong>@areaGroup.AreaName.ToUpper()</strong></td>
                    </tr>
                    @foreach (var item in areaGroup.CatalogItems)
                    {
                        <tr>
                            <td class="text-center">@(stt++)</td>
                            <td>@item.CourseCode</td>
                            <td>@item.CourseName</td>
                            <td class="text-center">@item.DurationHours</td>
                            <td>@item.Provider</td>
                            <td class="text-center">
                                <a asp-action="EditCatalogItem" asp-route-id="@item.Id" class="btn btn-warning btn-sm" title="Sửa">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>

                                <form asp-action="DeleteCatalogItem" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm" title="Xóa"
                                            onclick="return confirm('Bạn có chắc chắn muốn xóa (ẩn) khóa học này không?');">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted fst-italic py-3">
                        Chưa có khóa học nào trong danh mục.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>