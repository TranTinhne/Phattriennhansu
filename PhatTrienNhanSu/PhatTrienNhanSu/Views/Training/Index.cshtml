@using PhatTrienNhanSu.Service.TrainingService.Models
@model IEnumerable<ProgramSummary>

@{
    ViewData["Title"] = "Các Chương Trình Đào Tạo";
}

<h1>@ViewData["Title"]</h1>
<p>Dưới đây là danh sách các chương trình đào tạo đang hoạt động.</p>

<table class="table table-hover">
    <thead class="table-light">
        <tr>
            <th>Mã Chương trình</th>
            <th>Tên Chương trình</th>
            <th>Ngày bắt đầu</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var program in Model)
        {
            <tr>
                <td>@program.ProgramCode</td>
                <td><strong>@program.ProgramName</strong></td>
                <td>@(program.StartDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@program.ProgramID">Xem khóa học</a>
                </td>
            </tr>
        }
    </tbody>
</table>