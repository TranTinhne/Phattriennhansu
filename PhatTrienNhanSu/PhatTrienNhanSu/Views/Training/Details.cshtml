@using PhatTrienNhanSu.Service.TrainingService.Models
@model ProgramDetail

@{
    ViewData["Title"] = Model.ProgramName;
}

<h1>@Model.ProgramName</h1>
<hr />
<div>
    <h4>Mô tả chương trình</h4>
    <p>@Model.Description</p>
</div>

<h3 class="mt-4">Các khóa học có sẵn để đăng ký</h3>
<table class="table">
    <thead class="table-light">
        <tr>
            <th>Tên khóa học</th>
            <th>Giảng viên</th>
            <th>Địa điểm</th>
            <th>Ngày bắt đầu</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.AvailableCourses.Any())
        {
            @foreach (var course in Model.AvailableCourses)
            {
                <tr>
                    <td>@course.CourseName</td>
                    <td>@course.Instructor</td>
                    <td>@course.Location</td>
                    <td>@(course.StartDate?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    <td>
                        <form asp-controller="Training" asp-action="Register" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CourseId" value="@course.CourseID" />
                            <input type="hidden" name="ProgramId" value="@Model.ProgramID" />
                            <button type="submit" class="btn btn-primary btn-sm">Đăng ký</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">Hiện không có khóa học nào sắp diễn ra trong chương trình này.</td>
            </tr>
        }
    </tbody>
</table>
<div class="mt-3">
    <a asp-action="Index">Quay lại danh sách chương trình</a>
</div>